name: Veracode
on:
  push:
    branches: [ master ]
  workflow_dispatch:

jobs:
  Package:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4

      - name: Empacotar arquivos para Veracode
        run: |
          zip -r veracode.zip . -i '*.py' '*.html' '*.htm' '*.asp' '*.cjs' '*.css' '*.ehtml' '*.es' '*.es6' '*.handlebars' '*.hbs' '*.hjs' '*.js' '*.jsx' '*.json' '*.jsp' '*.jspx' '*.java' '*.map' '*.mjs' '*.mustache' '*.ts' '*.tsx' '*.vue' '*.xhtml' '*.lock' '*.module' '*.inc' '*.profile' '*.install' '*.engine' '*.theme' '*.php4' '*.php5' '*.php7' '*.phtml' '*.txt' -x '*/node_modules/*' '*/.git/*' '*/dist/*' '*test*' '*Test*' '*TEST*' '*teste*' '*Teste*' '*TESTE*'

      - name: Publicando Artefato
        uses: actions/upload-artifact@v4
        with:
          name: pacoteVeracode
          path: veracode.zip
          retention-days: 1

  Veracode_UploadAndScan:
    runs-on: ubuntu-latest
    needs: Package
    timeout-minutes: 60
    concurrency:
      group: veracode-uploadandscan-${{ github.repository }}
      cancel-in-progress: false
    steps:
      - name: Download Artefato
        uses: actions/download-artifact@v4
        with:
          name: pacoteVeracode

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: UploadAndScan
        uses: veracode/veracode-uploadandscan-action@0.2.10
        with:
          vid: ${{ secrets.VeracodeID }}
          vkey: ${{ secrets.VeracodeKey }}
          criticality: 'VeryHigh'
          appname: ${{ github.repository }}
          createsandbox: false
          filepath: 'veracode.zip'
          createprofile: true
          deleteincompletescan: true
          version: ${{ github.run_id }}

  Veracode_SCA:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4

      - name: Veracode SCA
        continue-on-error: true
        env:
          SRCCLR_API_TOKEN: ${{ secrets.SCA }}
        run: |
          curl -sSL 'https://sca-downloads.veracode.com/ci.sh' | bash -s scan --update-advisor --allow-dirty

  Veracode_SAST:
    runs-on: ubuntu-latest
    needs: Package
    timeout-minutes: 30
    steps:
      - name: Download Artefato
        uses: actions/download-artifact@v4
        with:
          name: pacoteVeracode

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Download Pipeline Scan
        run: |
          curl -sSO https://downloads.veracode.com/securityscan/pipeline-scan-LATEST.zip
          unzip -o pipeline-scan-LATEST.zip

      - name: Veracode Pipeline Scan
        continue-on-error: true
        env:
          VID: ${{ secrets.VeracodeID }}
          VKEY: ${{ secrets.VeracodeKey }}
          CaminhoArquivo: './veracode.zip'
          VeracodePolicyName: ${{ secrets.VeracodePolicyName }}
        run: |
          java -jar pipeline-scan.jar -vid "$VID" -vkey "$VKEY" -f "$CaminhoArquivo" \
            --issue_details true \
            -pn "$VeracodePolicyName"
