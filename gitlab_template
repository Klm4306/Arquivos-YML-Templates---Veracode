stages:
  - package
  - veracode_sca
  - veracode_iac_scan 
  - veracode_sast_scan  

variables:
  VERACODE_APP_NAME: "${CI_PROJECT_NAME}"
  VERACODE_PIPELINE_POLICY: "Veracode Recommended Medium"
  VERACODE_SAST_SCAN_TYPE: "pipeline"

package_application:
  image: alpine:latest
  stage: package
  script:
    - apk add --no-cache zip
    - zip -r uploadToVeracode.zip . -x ".git/*" -x ".gitlab-ci.yml"
    - ls -lh uploadToVeracode.zip
  artifacts:
    paths:
      - uploadToVeracode.zip
    expire_in: 7 days

veracode_sca:
  image: alpine:latest
  stage: veracode_sca
  before_script:
    - apk add --no-cache curl bash
  script:
    - curl -sSL https://sca-downloads.veracode.com/ci.sh | bash -s -- scan --allow-dirty --recursive

veracode_iac_scan:
  image: alpine:latest
  stage: veracode_iac_scan
  script:
    - apk add --no-cache curl
    - export VERACODE_API_KEY_ID="${VID}"
    - export VERACODE_API_KEY_SECRET="${VKEY}"
    - curl -fsS https://tools.veracode.com/veracode-cli/install | sh
    - ./veracode scan --source . --type directory --format table
  allow_failure: true

veracode_sast_pipeline_scan:
  image: veracode/pipeline-scan:latest
  stage: veracode_sast_scan
  rules:
    - if: '$VERACODE_SAST_SCAN_TYPE == "pipeline"'
  script:
    - java -jar /opt/veracode/pipeline-scan.jar -vid "${VID}" -vkey "${VKEY}" --file uploadToVeracode.zip --policy_name "${VERACODE_PIPELINE_POLICY}"
  allow_failure: true
  dependencies:
    - package_application

veracode_sast_sandbox_scan:
  image: veracode/api-wrapper-java
  stage: veracode_sast_scan
  rules:
    - if: '$VERACODE_SAST_SCAN_TYPE == "sandbox"'
  script:
    - java -jar /opt/veracode/api-wrapper.jar -action UploadAndScan -appname "${VERACODE_APP_NAME}" -createprofile true -vid "${VID}" -vkey "${VKEY}" -sandboxname "${CI_COMMIT_REF_NAME}" -createsandbox true -filepath uploadToVeracode.zip -version "Sandbox job ${CI_JOB_ID}" -deleteincompletescan 2 -scantimeout 30
  allow_failure: true
  dependencies:
    - package_application
